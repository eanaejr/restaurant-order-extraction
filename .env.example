# Names of the environment variables the service reads.
# This template is documentation only — the service never loads .env.example.
# Copy it to .env and paste your key: for local development app/config.py
# loads a .env at the project root (real environment variables always win).
# Never commit a real key.

# Required — get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-key-here

# Optional overrides (defaults shown)
GEMINI_MODEL=gemini-3.8-flash
GEMINI_THINKING_LEVEL=low
# Free-tier models tried in order when the primary one is overloaded
# (503 "high demand"). Set to an empty value to disable fallback.
#GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite, gemini-3.7-flash
# Fault injection for demos only (auth/quota/transient) — never in production
#GEMINI_SIMULATE_FAILURE=auth

# Only for legacy Gemini 2.5 models — for 3.x models the backend ignores
# temperature, so the service never sends it there.
#GEMINI_TEMPERATURE=0
